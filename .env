# =============================================================
# .env.example - SIGS
# =============================================================
# Copie este arquivo para ".env" (na mesma pasta) e ajuste os valores
# antes de subir o banco com "docker compose up -d". O arquivo ".env" é
# lido automaticamente pelo Docker Compose E pelo próprio app.py (via
# python-dotenv, ver requirements.txt), então as MESMAS variáveis valem
# para os dois lados — não precisa configurar em dois lugares.
#
# IMPORTANTE: nunca use estes valores padrão em produção. Troque a senha
# antes de expor a porta do banco em qualquer rede que não seja
# totalmente confiável (mesmo em rede local).
# =============================================================

# Nome do banco, usuário e senha do PostgreSQL.
POSTGRES_DB=sigs
POSTGRES_USER=sigs
POSTGRES_PASSWORD=admin@123456

# Porta publicada no host pelo docker-compose (padrão do PostgreSQL: 5432).
# Só precisa mudar se a porta 5432 já estiver em uso na sua máquina.
POSTGRES_PORT=5432

# Endereço do banco visto pelo app.py. Como o app roda nativamente no
# Windows (fora do Docker) e o container publica a porta no host, o valor
# correto aqui é sempre "localhost" (ou "127.0.0.1").
POSTGRES_HOST=localhost
